release_info() {
  local product="$1" version="$2"
  python3 - "$product" "$version" <<'PY'
import json
import sys
import urllib.request
import urllib.error

product = sys.argv[1]
version = sys.argv[2]

machine = __import__("platform").machine().lower()
if machine in ("x86_64", "amd64"):
    blocked_arches = ("aarch64", "arm64")
elif machine in ("aarch64", "arm64"):
    blocked_arches = ("x86_64", "amd64")
else:
    blocked_arches = ()

def asset_matches_host(name):
    lower = name.lower()
    return not any(arch in lower for arch in blocked_arches)

if product == "ge":
    if version == "latest":
        url = "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
    else:
        url = f"https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/tags/{version}"
    archive_suffixes = (".tar.gz",)
    checksum_suffix = ".sha512sum"
elif product == "dw":
    if version == "latest":
        url = "https://dawn.wine/api/v1/repos/dawn-winery/dwproton/releases/latest"
    else:
        url = f"https://dawn.wine/api/v1/repos/dawn-winery/dwproton/releases/tags/{version}"
    archive_suffixes = ("x86_64.tar.xz",)
    checksum_suffix = "x86_64.sha512sum"
elif product == "we":
    if version == "latest":
        url = "https://api.github.com/repos/SHORiN-KiWATA/we-proton/releases/latest"
    else:
        url = f"https://api.github.com/repos/SHORiN-KiWATA/we-proton/releases/tags/{version}"
    archive_suffixes = (".tar.xz",)
    checksum_suffix = ".sha512sum"
else:
    raise SystemExit(f"unknown product: {product}")

# WE-Proton releases also carry <tag>-source.tar.xz, the patched sources
excluded_suffixes = ("-source.tar.xz",)

request = urllib.request.Request(url, headers={"User-Agent": "proton-cli"})
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        data = json.load(response)
except urllib.error.HTTPError as exc:
    raise SystemExit(f"release not found for {product} {version}: HTTP {exc.code}")
except urllib.error.URLError as exc:
    raise SystemExit(f"failed to fetch release info for {product} {version}: {exc.reason}")

assets = data.get("assets") or []
tag = data.get("tag_name") or data.get("name") or version
archive = None
checksum = None

for asset in assets:
    name = asset.get("name", "")
    download = asset.get("browser_download_url", "")
    if not download:
        continue
    if archive is None and asset_matches_host(name) and any(name.endswith(suffix) for suffix in archive_suffixes) \
            and not any(name.endswith(suffix) for suffix in excluded_suffixes):
        archive = (name, download)
    if checksum is None and asset_matches_host(name) and name.endswith(checksum_suffix):
        checksum = (name, download)

if archive is None:
    raise SystemExit(f"archive asset not found for {product} {version}")
if checksum is None:
    raise SystemExit(f"checksum asset not found for {product} {version}")

print(tag)
print(archive[0])
print(archive[1])
print(checksum[0])
print(checksum[1])
PY
}

fetch_file() {
  local url="$1" dest="$2" tmp timeout_prefix product title status
  if [[ -s "$dest" ]]; then
    printf 'Using existing: %s\n' "$dest"
    return 0
  fi

  tmp="$dest.part"
  timeout_prefix=()
  # Only wrap in `timeout` when a total cap was explicitly requested; a healthy
  # but slow transfer must be allowed to finish. Stalls are caught by curl/wget.
  if [[ "$DOWNLOAD_TIMEOUT_SECONDS" -gt 0 ]] && command -v timeout >/dev/null 2>&1; then
    timeout_prefix=(timeout "${DOWNLOAD_TIMEOUT_SECONDS}s")
  fi
  product="${DOWNLOAD_NOTIFY_PRODUCT:-$(basename "$dest")}"
  title="Shorin Proton Wrapper"
  status=0
  if command -v curl >/dev/null 2>&1; then
    run_download_command_with_notifications "$title" "$product" "${timeout_prefix[@]}" \
      curl -L --fail --progress-bar --connect-timeout 30 \
        --speed-limit 1024 --speed-time "$DOWNLOAD_STALL_SECONDS" \
        --retry 3 --retry-delay 5 -C - -o "$tmp" "$url" || status=$?
  elif command -v wget >/dev/null 2>&1; then
    run_download_command_with_notifications "$title" "$product" "${timeout_prefix[@]}" \
      wget --continue --timeout=30 --read-timeout="$DOWNLOAD_STALL_SECONDS" --tries=3 -O "$tmp" "$url" || status=$?
  else
    install_error "curl or wget is required for downloads"
    return 1
  fi

  if [[ $status -ne 0 ]]; then
    # Keep the partial file: the next attempt resumes instead of restarting.
    install_error "download failed (exit $status): $url"
    return 1
  fi
  mv "$tmp" "$dest"
}

notify_available() {
  command -v notify-send >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]
}

# One run keeps a single notification and updates it in place (download,
# extraction, done, prefix setup, errors) instead of stacking new ones.
NOTIFY_ID=""
NOTIFY_CAN_REPLACE=""

notify_can_replace() {
  if [[ -z "$NOTIFY_CAN_REPLACE" ]]; then
    NOTIFY_CAN_REPLACE=0
    if notify-send --help 2>/dev/null | grep -q -- '--replace-id'; then
      NOTIFY_CAN_REPLACE=1
    fi
  fi
  [[ "$NOTIFY_CAN_REPLACE" == 1 ]]
}

notify_send() {
  local urgency="$1" expire="$2" title="$3" message="$4" id
  local args=(--app-name="Shorin Proton Wrapper" --app-icon=shorin-proton --icon=shorin-proton --urgency="$urgency")
  notify_available || return 0
  [[ -n "$expire" ]] && args+=(--expire-time="$expire")
  if notify_can_replace; then
    [[ -n "$NOTIFY_ID" ]] && args+=(--replace-id="$NOTIFY_ID")
    if id="$(notify-send "${args[@]}" --print-id "$title" "$message" 2>/dev/null)" && [[ "$id" =~ ^[0-9]+$ ]]; then
      NOTIFY_ID="$id"
    fi
  else
    notify-send "${args[@]}" "$title" "$message" >/dev/null 2>&1 || true
  fi
}

# Something is still going on: stay up until the next update replaces it.
notify_progress() {
  notify_send normal "$(( DOWNLOAD_NOTIFY_INTERVAL * 1000 + 5000 ))" "$1" "$2"
}

notify_download() {
  notify_send normal "$DOWNLOAD_NOTIFY_EXPIRE" "$1" "$2"
}

# Errors must survive a desktop launch, where stderr goes nowhere. Critical
# urgency keeps the notification on screen until it is dismissed.
notify_error() {
  notify_send critical "" "Shorin Proton Wrapper" "$1"
}

# Record a failure reason and report it, without killing the caller: the
# caller still has to notify the user and clean up.
install_error() {
  INSTALL_ERROR="$*"
  printf 'shorin-proton-wrapper: %s\n' "$*" >&2
}

die_visible() {
  notify_error "$*"
  die "$@"
}

download_message() {
  local key="$1" product="$2"
  if [[ "$(ui_lang)" == "zh" ]]; then
    case "$key" in
      start) printf '正在下载 %s...\n' "$product" ;;
      downloaded) printf '%s 下载完成，正在解压安装...\n' "$product" ;;
      extracting) printf '正在解压 %s，请稍候...\n' "$product" ;;
      done) printf '%s 已安装完成。\n' "$product" ;;
      failed) printf '%s 下载或安装失败。\n' "$product" ;;
      timeout) printf '%s 下载超时，已终止。\n' "$product" ;;
      init) printf '正在初始化运行环境，首次运行需要几分钟...\n' ;;
      init_failed) printf '运行环境初始化失败。\n' ;;
      runtime_fallback) printf 'Steam 运行时不可用，这次在宿主机上直接运行 Proton，视频和音频解码等可能出问题。\n' ;;
    esac
  else
    case "$key" in
      start) printf 'Downloading %s...\n' "$product" ;;
      downloaded) printf '%s download completed. Extracting and installing...\n' "$product" ;;
      extracting) printf 'Extracting %s, please wait...\n' "$product" ;;
      done) printf '%s has been installed.\n' "$product" ;;
      failed) printf 'Failed to download or install %s.\n' "$product" ;;
      timeout) printf '%s download timed out and was stopped.\n' "$product" ;;
      init) printf 'Setting up the runtime environment. The first run takes a few minutes...\n' ;;
      init_failed) printf 'Failed to set up the runtime environment.\n' ;;
      runtime_fallback) printf 'The Steam Linux Runtime is not available; running Proton directly this time, so e.g. video and audio decoding may fail.\n' ;;
    esac
  fi
}

run_download_command_with_notifications() {
  local title product pid notifier_pid status message
  title="$1"
  product="$2"
  shift 2

  message="$(download_message start "$product")"
  notify_progress "$title" "$message"
  "$@" &
  pid=$!
  notifier_pid=""
  # Refresh the same notification so it stays up for the whole download.
  # Without in-place updates every refresh would be a new notification.
  if notify_available && notify_can_replace; then
    (
      while sleep "$DOWNLOAD_NOTIFY_INTERVAL"; do
        kill -0 "$pid" >/dev/null 2>&1 || exit 0
        notify_progress "$title" "$message"
      done
    ) &
    notifier_pid=$!
  fi

  status=0
  wait "$pid" || status=$?
  if [[ -n "$notifier_pid" ]]; then
    kill "$notifier_pid" >/dev/null 2>&1 || true
    wait "$notifier_pid" >/dev/null 2>&1 || true
  fi
  if [[ $status -eq 124 ]]; then
    message="$(download_message timeout "$product")"
    notify_download "$title" "$message"
  fi
  # Other failures are reported once, with a reason, by the install caller.
  return "$status"
}

install_runner_with_notifications() {
  local product title message status old_product log_dir
  product="$(runner_dir_name "$(normalize_product "$PRODUCT")")"
  title="Shorin Proton Wrapper"
  old_product="${DOWNLOAD_NOTIFY_PRODUCT:-}"
  DOWNLOAD_NOTIFY_PRODUCT="$product"
  INSTALL_ERROR=""

  log_dir="$WRAPPER_CACHE_DIR/logs"
  mkdir -p "$log_dir"
  INSTALL_LOG="$log_dir/install-$(safe_log_name "$product").log"
  : > "$INSTALL_LOG"

  status=0
  install_runner > >(tee -a "$INSTALL_LOG") 2>&1 || status=$?

  if [[ -n "$old_product" ]]; then
    DOWNLOAD_NOTIFY_PRODUCT="$old_product"
  else
    unset DOWNLOAD_NOTIFY_PRODUCT
  fi

  if [[ $status -ne 0 ]]; then
    message="$(download_message failed "$product")"
    if [[ -n "$INSTALL_ERROR" ]]; then
      message="$message"$'\n'"$INSTALL_ERROR"
    fi
    message="$message"$'\n'"$INSTALL_LOG"
    notify_error "$message"
  else
    message="$(download_message done "$product")"
    notify_download "$title" "$message"
  fi
  return "$status"
}

verify_archive() {
  local dir="$1" checksum_name="$2"
  if ! (cd "$dir" && sha512sum -c "$checksum_name"); then
    install_error "checksum verification failed: $dir/$checksum_name
The download is incomplete or corrupted. It has been discarded; run again to re-download."
    return 1
  fi
}

dir_free_kib() {
  df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

file_size_kib() {
  local size
  size="$(stat -c %s "$1" 2>/dev/null || printf '0')"
  printf '%s\n' "$(( (size + 1023) / 1024 ))"
}

# Proton archives expand to roughly five times their compressed size. Refuse
# early with a clear reason instead of failing halfway through tar.
check_extract_space() {
  local archive="$1" dest="$2" needed free
  needed=$(( $(file_size_kib "$archive") * 5 ))
  free="$(dir_free_kib "$dest")"
  [[ "$free" =~ ^[0-9]+$ ]] || return 0
  if [[ "$free" -lt "$needed" ]]; then
    install_error "not enough free space in $dest
Need about $(( (needed + 1023) / 1024 )) MiB, only $(( free / 1024 )) MiB available."
    return 1
  fi
}

find_extracted_runner_root() {
  local extract_dir="$1" path
  if [[ -x "$extract_dir/proton" ]]; then
    printf '%s\n' "$extract_dir"
    return 0
  fi

  shopt -s nullglob
  for path in "$extract_dir"/*; do
    if [[ -d "$path" && -x "$path/proton" ]]; then
      shopt -u nullglob
      printf '%s\n' "$path"
      return 0
    fi
  done
  shopt -u nullglob

  return 1
}

installed_runner_version() {
  local target="$1" product="$2" line version

  if [[ -r "$target/.shorin-proton-wrapper-version" ]]; then
    sed -n '1p' "$target/.shorin-proton-wrapper-version"
    return 0
  fi

  if [[ -r "$target/version" ]]; then
    line="$(sed -n '1p' "$target/version")"
    case "$product" in
      ge)
        version="$(printf '%s\n' "$line" | grep -o 'GE-Proton[^[:space:]]*' | head -n 1 || true)"
        ;;
      dw)
        version="$(printf '%s\n' "$line" | grep -o 'dwproton-[^[:space:]]*' | head -n 1 || true)"
        ;;
      we)
        version="$(printf '%s\n' "$line" | grep -o 'we-proton-[^[:space:]]*' | head -n 1 || true)"
        ;;
      *)
        version=""
        ;;
    esac
    [[ -n "$version" ]] && printf '%s\n' "$version"
  fi
}

download_runner() {
  local product info tag archive_name archive_url checksum_name checksum_url dir release_output
  product="$(normalize_product "$PRODUCT")"
  info=()
  release_output="$(release_info "$product" "$VERSION" 2>&1)" || die "$release_output"
  mapfile -t info <<< "$release_output"
  tag="${info[0]:-}" archive_name="${info[1]:-}" archive_url="${info[2]:-}" checksum_name="${info[3]:-}" checksum_url="${info[4]:-}"
  [[ -n "$tag" ]] || die "release not found for $product $VERSION"
  dir="$(expand_path "${DOWNLOAD_DIR:-$(xdg_download_dir)}")"

  mkdir -p "$dir"
  fetch_file "$archive_url" "$dir/$archive_name" || exit 1
  fetch_file "$checksum_url" "$dir/$checksum_name" || exit 1
  verify_archive "$dir" "$checksum_name" || exit 1

  printf 'Downloaded: %s\n' "$dir/$archive_name"
  printf 'Checksum:   %s\n' "$dir/$checksum_name"
  printf 'Verified:   yes\n'
  printf 'Version:    %s\n' "$tag"
}

# Whether a running process executes from this runner directory. Replacing
# a runner under a running session would leave its wineserver on the old
# version and every program that joins the session on the new one.
runner_in_use() {
  local dir proc exe
  dir="$(realpath -m "$1")"
  for proc in /proc/[0-9]*; do
    exe="$(readlink "$proc/exe" 2>/dev/null)" || continue
    exe="${exe#/run/host}"
    [[ "$exe" == "$dir/"* ]] && return 0
  done
  return 1
}

# Returns non-zero on failure and leaves the reason in INSTALL_ERROR. It must
# never exit: the caller is responsible for telling the user what went wrong.
install_runner() {
  local product info tag archive_name archive_url checksum_name checksum_url download_dir install_dir work_dir use_existing extract_dir root target temp_download_dir dir_name release_output release_err
  local product_name title
  product="$(normalize_product "$PRODUCT")"
  info=()
  release_err="$(mktemp)"
  if ! release_output="$(release_info "$product" "$VERSION" 2>"$release_err")"; then
    install_error "$(<"$release_err")"
    rm -f "$release_err"
    return 1
  fi
  rm -f "$release_err"
  mapfile -t info <<< "$release_output"
  tag="${info[0]:-}" archive_name="${info[1]:-}" archive_url="${info[2]:-}" checksum_name="${info[3]:-}" checksum_url="${info[4]:-}"
  if [[ -z "$tag" || -z "$archive_name" || -z "$checksum_name" ]]; then
    install_error "release not found for $product $VERSION"
    return 1
  fi
  download_dir="$(expand_path "${DOWNLOAD_DIR:-$INSTALL_DOWNLOAD_DIR}")"
  install_dir="$(expand_path "${INSTALL_DIR:-$(default_install_dir)}")"
  dir_name="$(runner_target_dir_name "$product" "$VERSION" "$tag")"
  target="$install_dir/$dir_name"
  product_name="$(runner_dir_name "$product")"
  title="Shorin Proton Wrapper"

  mkdir -p "$download_dir" "$install_dir"
  find "$download_dir" -maxdepth 1 -type d \( -name 'install-*' -o -name 'partial-*' \) -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
  find "$install_dir" -maxdepth 1 -type d -name '.shorin-extract-*' -mmin +60 -exec rm -rf {} + 2>/dev/null || true

  use_existing=0
  temp_download_dir=""
  extract_dir=""

  cleanup_install_failure() {
    [[ -n "$extract_dir" ]] && rm -rf "$extract_dir"
    return 0
  }

  if [[ -s "$download_dir/$archive_name" && -s "$download_dir/$checksum_name" ]]; then
    work_dir="$download_dir"
    use_existing=1
    printf 'Using downloaded files in: %s\n' "$download_dir"
  else
    # A fixed directory per release, not a random one: a retry after a dropped
    # connection resumes the partial file instead of downloading it all again.
    temp_download_dir="$download_dir/partial-$tag"
    work_dir="$temp_download_dir"
    mkdir -p "$work_dir"
    if ! fetch_file "$archive_url" "$work_dir/$archive_name"; then
      return 1
    fi
    if ! fetch_file "$checksum_url" "$work_dir/$checksum_name"; then
      return 1
    fi
    notify_progress "$title" "$(download_message downloaded "$product_name")"
  fi

  if ! verify_archive "$work_dir" "$checksum_name"; then
    # A corrupt file must not be resumed, so this is the one case that discards it.
    rm -f "$work_dir/$archive_name" "$work_dir/$archive_name.part" "$work_dir/$checksum_name"
    return 1
  fi

  if ! check_extract_space "$work_dir/$archive_name" "$install_dir"; then
    return 1
  fi

  notify_progress "$title" "$(download_message extracting "$product_name")"

  # Extract next to the install target, not in /tmp: /tmp is usually a tmpfs
  # backed by RAM, and this keeps the final move a same-filesystem rename.
  if ! extract_dir="$(mktemp -d "$install_dir/.shorin-extract-XXXXXX")"; then
    install_error "failed to create a work directory in: $install_dir"
    return 1
  fi
  if ! tar -xf "$work_dir/$archive_name" -C "$extract_dir"; then
    cleanup_install_failure
    install_error "failed to extract archive: $work_dir/$archive_name
The archive may be corrupted or the disk may be full."
    return 1
  fi
  if ! root="$(find_extracted_runner_root "$extract_dir")"; then
    cleanup_install_failure
    install_error "extracted archive does not contain a proton runner: $work_dir/$archive_name"
    return 1
  fi
  if [[ -e "$target" && ! -x "$target/proton" ]]; then
    cleanup_install_failure
    install_error "install target exists but is not a runner: $target"
    return 1
  fi
  if [[ -e "$target" ]] && runner_in_use "$target"; then
    cleanup_install_failure
    install_error "runner is in use: $target
Close the programs running with it, then update again."
    return 1
  fi
  if ! rm -rf "$target"; then
    cleanup_install_failure
    install_error "failed to remove old install target: $target"
    return 1
  fi
  if ! mv "$root" "$target"; then
    cleanup_install_failure
    install_error "failed to install runner to: $target"
    return 1
  fi
  printf '%s\n' "$tag" > "$target/.shorin-proton-wrapper-version"
  if [[ "$VERSION" == "latest" ]]; then
    pin_runner_tool_name "$target" "$product_name" "$tag"
  fi
  rm -rf "$extract_dir"
  extract_dir=""

  if [[ $use_existing -eq 0 ]]; then
    rm -rf "$work_dir"
    temp_download_dir=""
  elif [[ $CLEAN -eq 1 ]]; then
    rm -f "$download_dir/$archive_name" "$download_dir/$checksum_name"
  fi

  printf 'Installed: %s\n' "$target/proton"
}

# Steam remembers each game's compatibility tool by the tool's internal name
# in compatibilitytool.vdf, which a release sets to its version. A "Latest"
# runner is replaced on every update, and a new name each time would leave the
# games set to it without a tool, so it keeps one name: its folder's, and the
# version goes into the name Steam shows.
pin_runner_tool_name() {
  local dir="$1" name="$2" version="$3"
  [[ -f "$dir/compatibilitytool.vdf" ]] || return 0
  python3 - "$dir/compatibilitytool.vdf" "${name// /-}" "$name${version:+ ($version)}" <<'PY'
import re
import sys

path, internal, display = sys.argv[1:]
with open(path, encoding="utf-8") as file:
    text = file.read()
# the first key in "compat_tools" is the tool's internal name
match = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', text)
if not match:
    sys.exit(0)
text = text[:match.start(1)] + internal + text[match.end(1):]
text = re.sub(r'("display_name"\s+)"[^"]*"', lambda m: m.group(1) + '"' + display + '"', text, count=1)
with open(path, "w", encoding="utf-8") as file:
    file.write(text)
PY
}

# Whether release $2 is newer than the installed version $1. A runner built
# locally, or installed before a release was withdrawn, can be ahead of the
# latest release; replacing it would be a downgrade.
version_newer() {
  [[ "$1" != "$2" && "$(printf '%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$2" ]]
}

update_runner() {
  local product target install_to_old old_product old_version release_output tag current found updated skipped
  local -A latest_tags=()
  install_to_old="$INSTALL_TO"
  old_product="$PRODUCT"
  old_version="$VERSION"
  VERSION="latest"
  found=0
  updated=0
  skipped=0

  for INSTALL_TO in local steam lutris; do
    for product in ge dw we; do
      PRODUCT="$product"
      target="$(expand_path "$(default_install_dir)")/$(runner_dir_name "$product")"
      if [[ -e "$target" ]]; then
        found=1
        # one lookup per product, though it may be installed in several places
        if [[ ! -v "latest_tags[$product]" ]]; then
          release_output="$(release_info "$product" latest 2>&1)" || die "$release_output"
          latest_tags[$product]="${release_output%%$'\n'*}"
        fi
        tag="${latest_tags[$product]}"
        [[ -n "$tag" ]] || die "release not found for $product latest"
        current="$(installed_runner_version "$target" "$product" || true)"
        if [[ "$current" == "$tag" ]]; then
          printf 'Already latest: %s (%s)\n' "$target" "$tag"
          pin_runner_tool_name "$target" "$(runner_dir_name "$product")" "$current"
          skipped=1
        elif [[ -n "$current" ]] && ! version_newer "$current" "$tag"; then
          printf 'Newer than the latest release, kept: %s (%s, latest %s)\n' "$target" "$current" "$tag"
          pin_runner_tool_name "$target" "$(runner_dir_name "$product")" "$current"
          skipped=1
        else
          printf 'Updating: %s\n' "$target"
          if [[ -n "$current" ]]; then
            printf '  %s -> %s\n' "$current" "$tag"
          fi
          install_runner_with_notifications || die_install "failed to update runner: $product"
          updated=1
        fi
      fi
    done
  done

  INSTALL_TO="$install_to_old"
  PRODUCT="$old_product"
  VERSION="$old_version"
  [[ $found -eq 1 ]] || die "no installed Latest runners found"
  if [[ $updated -eq 0 && $skipped -eq 1 ]]; then
    printf 'All installed Latest runners are up to date.\n'
  fi
}

check_update_runner() {
  local product target release_output tag current found
  local install_to_old old_product old_version
  local -A latest_tags=()
  install_to_old="$INSTALL_TO"
  old_product="$PRODUCT"
  old_version="$VERSION"
  VERSION="latest"
  found=0

  for INSTALL_TO in local steam lutris; do
    for product in ge dw we; do
      PRODUCT="$product"
      target="$(expand_path "$(default_install_dir)")/$(runner_dir_name "$product")"
      if [[ -e "$target" ]]; then
        found=1
        if [[ ! -v "latest_tags[$product]" ]]; then
          release_output="$(release_info "$product" latest 2>/dev/null)" || release_output=""
          latest_tags[$product]="${release_output%%$'\n'*}"
        fi
        tag="${latest_tags[$product]}"
        [[ -n "$tag" ]] || continue
        current="$(installed_runner_version "$target" "$product" 2>/dev/null || true)"
        if [[ -n "$current" ]] && version_newer "$current" "$tag"; then
          printf '%s\t%s\t->\t%s\t(%s)\n' "$product" "$current" "$tag" "$INSTALL_TO"
        fi
      fi
    done
  done

  INSTALL_TO="$install_to_old"
  PRODUCT="$old_product"
  VERSION="$old_version"
  [[ $found -eq 1 ]] || return 0
  return 0
}

remove_runner() {
  local product dir_name install_dir target targets removed lang
  product="$(normalize_product "$PRODUCT")"
  dir_name="$(runner_target_dir_name "$product" "$VERSION")"
  install_dir="$(expand_path "${INSTALL_DIR:-$(default_install_dir)}")"
  targets=("$install_dir/$dir_name")
  # --remove also takes what earlier versions installed in the old place
  if [[ -z "$INSTALL_DIR" && "$INSTALL_TO" == "default" ]]; then
    targets+=("$LOCAL_RUNNER_DIR/$dir_name")
  fi
  lang="$(ui_lang)"

  removed=0
  for target in "${targets[@]}"; do
    [[ -e "$target" ]] || continue
    rm -rf "$target"
    removed=1
    if [[ "$lang" == "zh" ]]; then
      printf '已移除: %s\n' "$target"
    else
      printf 'Removed: %s\n' "$target"
    fi
  done

  if [[ $removed -eq 0 ]]; then
    if [[ "$lang" == "zh" ]]; then
      die "$dir_name 未安装"
    else
      die "$dir_name is not installed"
    fi
  fi
}

remove_all_runners() {
  local install_dir path removed lang
  install_dir="$(expand_path "${INSTALL_DIR:-$(default_install_dir)}")"
  lang="$(ui_lang)"
  removed=0

  shopt -s nullglob
  for path in "$install_dir"/*; do
    if [[ -d "$path" && -f "$path/.shorin-proton-wrapper-version" ]]; then
      rm -rf "$path"
      removed=1
      if [[ "$lang" == "zh" ]]; then
        printf '已移除: %s\n' "$path"
      else
        printf 'Removed: %s\n' "$path"
      fi
    fi
  done
  shopt -u nullglob

  if [[ $removed -eq 0 ]]; then
    if [[ "$lang" == "zh" ]]; then
      die "没有找到由 shorin-proton-wrapper 安装的运行器: $install_dir"
    else
      die "no runners installed by shorin-proton-wrapper found in: $install_dir"
    fi
  fi
}

ensure_runner_product() {
  local product="$1" old_product old_version old_install_to status
  if try_resolve_runner_product "$product"; then
    return 0
  fi

  old_product="$PRODUCT"
  old_version="$VERSION"
  old_install_to="$INSTALL_TO"

  PRODUCT="$product"
  VERSION="latest"
  INSTALL_TO="default"
  status=0
  install_runner_with_notifications || status=$?

  PRODUCT="$old_product"
  VERSION="$old_version"
  INSTALL_TO="$old_install_to"

  [[ $status -eq 0 ]] || return 1

  try_resolve_runner_product "$product"
}

# install_runner_with_notifications has already shown the reason; only announce
# it here when the failure happened somewhere that stayed silent.
die_install() {
  if [[ -n "$INSTALL_ERROR" ]]; then
    die "$*"
  fi
  die_visible "$*"
}

select_init_runner() {
  local product
  if [[ -n "$RUNNER_ARG" ]]; then
    if product="$(runner_product_alias "$RUNNER_ARG")"; then
      ensure_runner_product "$product" || die_install "failed to install runner: $product"
    else
      resolve_runner_arg "$RUNNER_ARG"
    fi
    return 0
  fi

  ensure_runner_product "$DEFAULT_PRODUCT" || die_install "failed to install runner: $DEFAULT_PRODUCT"
}

# ------------------------------------------------------------ Steam runtime
# Proton is built for the Steam Linux Runtime container its toolmanifest.vdf
# names. Run directly on the host its bundled libraries miss dependencies, e.g.
# the GStreamer plugins Wine decodes WMA, WMV and H.264 with.

# Steam directory, umu directory, download directory and archive of a runtime.
runtime_info() {
  case "$1" in
    4183110) printf '%s\n' SteamLinuxRuntime_4 steamrt4 \
      "https://repo.steampowered.com/steamrt4/images/latest-public-stable/" SteamLinuxRuntime_4.tar.xz ;;
    1628350) printf '%s\n' SteamLinuxRuntime_sniper steamrt3 \
      "https://repo.steampowered.com/steamrt-images-sniper/snapshots/latest-container-runtime-public-beta/" \
      SteamLinuxRuntime_sniper.tar.xz ;;
    *) return 1 ;;
  esac
}

required_runtime_appid() {
  local manifest appid
  manifest="$(dirname "$1")/toolmanifest.vdf"
  [[ -r "$manifest" ]] || return 1
  appid="$(sed -n 's/.*"require_tool_appid"[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' "$manifest" | head -n 1)"
  [[ -n "$appid" ]] || return 1
  printf '%s\n' "$appid"
}

# WE-Proton before release 10 was linked against host libraries the runtime
# does not have; it only works run directly.
runner_is_old_weproton() {
  local label oldest="we-proton-11.0-14-10"
  label="$(awk '{print $NF}' "$(dirname "$1")/version" 2>/dev/null || true)"
  [[ "$label" == we-proton-* && "$label" != "$oldest" ]] || return 1
  [[ "$(printf '%s\n' "$label" "$oldest" | sort -V | head -n 1)" == "$label" ]]
}

steam_library_roots() {
  printf '%s\n' "$HOME/.local/share/Steam" "$HOME/.steam/root" "$HOME/.steam/steam" \
    "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
  read_steam_libraries
}

# An installed copy of the runtime: ours, umu's or Steam's.
find_runtime() {
  local info dir lib
  mapfile -t info < <(runtime_info "$1") || return 1
  [[ ${#info[@]} -eq 4 ]] || return 1
  for dir in "$RUNTIME_DIR/${info[1]}" "$XDG_DATA_HOME_VALUE/umu/${info[1]}"; do
    if [[ -f "$dir/_v2-entry-point" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
  while IFS= read -r lib; do
    dir="$lib/steamapps/common/${info[0]}"
    if [[ -f "$dir/_v2-entry-point" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done < <(steam_library_roots)
  return 1
}

fetch_text() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 30 "$1"
  else
    wget -qO- --timeout=30 "$1"
  fi
}

# Download the runtime from Valve into $RUNTIME_DIR, checked against SHA256SUMS.
download_runtime() {
  local info sums expected dest staging old_product title="Shorin Proton Wrapper" status=0
  mapfile -t info < <(runtime_info "$1")
  mkdir -p "$INSTALL_DOWNLOAD_DIR" "$RUNTIME_DIR"
  if ! sums="$(fetch_text "${info[2]}SHA256SUMS")"; then
    install_error "cannot fetch ${info[2]}SHA256SUMS"
    return 1
  fi
  expected="$(awk -v f="${info[3]}" '{n = $NF; sub(/^\*/, "", n)} n == f {print $1; exit}' <<< "$sums")"
  if [[ -z "$expected" ]]; then
    install_error "no checksum for ${info[3]} in ${info[2]}SHA256SUMS"
    return 1
  fi

  dest="$INSTALL_DOWNLOAD_DIR/${info[3]}"
  old_product="${DOWNLOAD_NOTIFY_PRODUCT:-}"
  DOWNLOAD_NOTIFY_PRODUCT="Steam Linux Runtime"
  fetch_file "${info[2]}${info[3]}" "$dest" || status=$?
  DOWNLOAD_NOTIFY_PRODUCT="$old_product"
  [[ $status -eq 0 ]] || return 1
  if [[ "$(sha256sum "$dest" | cut -d' ' -f1)" != "$expected" ]]; then
    rm -f "$dest"
    install_error "checksum verification failed: $dest
The download is incomplete or corrupted. It has been discarded; run again to re-download."
    return 1
  fi

  notify_progress "$title" "$(download_message extracting "Steam Linux Runtime")"
  if ! staging="$(mktemp -d "$RUNTIME_DIR/.extract-XXXXXX")"; then
    install_error "failed to create a work directory in: $RUNTIME_DIR"
    return 1
  fi
  if ! tar -xJf "$dest" -C "$staging" || [[ ! -f "$staging/${info[0]}/_v2-entry-point" ]]; then
    rm -rf "$staging"
    install_error "failed to extract: $dest"
    return 1
  fi
  rm -rf "${RUNTIME_DIR:?}/${info[1]}"
  mv "$staging/${info[0]}" "$RUNTIME_DIR/${info[1]}"
  rm -rf "$staging" "$dest"
  notify_download "$title" "$(download_message done "Steam Linux Runtime")"
}

# Set RUNTIME_PREFIX to the command that runs this Proton inside its runtime,
# downloading the runtime first if needed. It stays empty, and Proton runs
# directly, when the runtime is turned off, the Proton asks for none we know,
# or the runtime cannot be had.
prepare_runtime() {
  local runner="$1" verb="$2" appid runtime log status=0
  RUNTIME_PREFIX=()
  [[ "$RUNTIME_ENABLED" != 0 ]] || return 0
  appid="$(required_runtime_appid "$runner")" || return 0
  runtime_info "$appid" >/dev/null || return 0
  if runner_is_old_weproton "$runner"; then
    return 0
  fi
  if ! runtime="$(find_runtime "$appid")"; then
    log="$WRAPPER_CACHE_DIR/logs/install-runtime.log"
    mkdir -p "$(dirname "$log")"
    : > "$log"
    INSTALL_ERROR=""
    download_runtime "$appid" > >(tee -a "$log" >&2) 2>&1 || status=$?
    if [[ $status -ne 0 ]] || ! runtime="$(find_runtime "$appid")"; then
      notify_error "$(download_message runtime_fallback "")"$'\n'"${INSTALL_ERROR:+$INSTALL_ERROR$'\n'}$log"
      printf 'shorin-proton-wrapper: %s\n' "$(download_message runtime_fallback "")" >&2
      return 0
    fi
  fi
  RUNTIME_PREFIX=("$runtime/_v2-entry-point" "--verb=$verb" "--")
}

validate_resolution() {
  [[ "$1" =~ ^[0-9]+x[0-9]+$ ]] || die "invalid resolution: $1"
}

validate_number() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "invalid number: $1"
}

prepare_mangohud_env() {
  MANGOHUD_ENV=()
  [[ $MANGOHUD -eq 1 ]] || return 0
  command -v mangohud >/dev/null 2>&1 || die_visible "mangohud is not installed"
  MANGOHUD_ENV=("MANGOHUD=1")
}

append_gamescope_extra_args() {
  local extra="$1" tmp err status
  [[ -n "$extra" ]] || return 0
  tmp="$(mktemp)"
  err="$(mktemp)"
  python3 - "$extra" > "$tmp" 2> "$err" <<'PY'
import shlex
import sys

try:
    args = shlex.split(sys.argv[1])
except ValueError as exc:
    raise SystemExit(f"invalid Gamescope arguments: {exc}")

for arg in args:
    sys.stdout.write(arg)
    sys.stdout.write("\0")
PY
  status=$?
  if [[ $status -ne 0 ]]; then
    local message
    message="$(<"$err")"
    rm -f "$tmp" "$err"
    die "${message:-invalid Gamescope arguments: $extra}"
  fi
  mapfile -d '' -t GAMESCOPE_EXTRA_ARGS < "$tmp"
  rm -f "$tmp" "$err"
  GAMESCOPE_ARGS+=("${GAMESCOPE_EXTRA_ARGS[@]}")
}

build_gamescope_args() {
  GAMESCOPE_ARGS=()
  [[ $GAMESCOPE -eq 1 ]] || return 0
  command -v gamescope >/dev/null 2>&1 || die_visible "gamescope is not installed"

  if [[ $GAMESCOPE_FULLSCREEN -eq 1 ]]; then
    GAMESCOPE_ARGS+=("-f")
  fi
  if [[ -n "$GAMESCOPE_RES" ]]; then
    validate_resolution "$GAMESCOPE_RES"
    GAMESCOPE_ARGS+=("-w" "${GAMESCOPE_RES%x*}" "-h" "${GAMESCOPE_RES#*x}")
  fi
  if [[ -n "$GAMESCOPE_FPS" ]]; then
    validate_number "$GAMESCOPE_FPS"
    GAMESCOPE_ARGS+=("-r" "$GAMESCOPE_FPS")
  fi
  if [[ $GAMESCOPE_FSR -eq 1 ]]; then
    GAMESCOPE_ARGS+=("-F" "fsr")
  fi
  append_gamescope_extra_args "$GAMESCOPE_EXTRA"
}

# The command that runs a Windows program, in LAUNCH_CMD:
#   [gamescope ... -- wrapper --in-gamescope --] [nsenter ... --] env ... [runtime --] runner args
# Gamescope stays outside the session's network namespace: inside it the real
# root is unmapped, /tmp/.X11-unix looks owned by nobody and gamescope refuses
# to start its Xwayland. The program still reaches that Xwayland through the
# socket file; the abstract socket is per network namespace.
LAUNCH_CMD=()
JOIN_PREFIX=()
SESSION_ENV=()

build_launch_command() {
  local type="$1" runner="$2" env_args
  shift 2
  validate_runner_arch "$runner"
  prepare_mangohud_env
  LAUNCH_CMD=()
  if [[ $GAMESCOPE -eq 1 ]]; then
    build_gamescope_args
    LAUNCH_CMD+=(gamescope "${GAMESCOPE_ARGS[@]}" -- "$SELF_PATH" --in-gamescope --)
  fi
  LAUNCH_CMD+=("${JOIN_PREFIX[@]}")
  env_args=("${MANGOHUD_ENV[@]}" "${DEBUG_ENV[@]}" "${CACHED_ENV[@]}" "${RUN_ENV[@]}")
  # Wine's new WoW64 mode runs 32-bit programs through the 64-bit host
  # libraries: no 32-bit system libraries are needed, and they get the fixes
  # WE-Proton builds for 64 bits only, e.g. the builtin wintun accelerator
  # engines (32-bit) need. PROTON_USE_WOW64=0, set outside or in an exe's
  # environment variables, turns it off.
  if [[ "$type" == "proton" && -z "${PROTON_USE_WOW64:-}" ]] \
      && ! printf '%s\n' "${CACHED_ENV[@]}" | grep -q '^PROTON_USE_WOW64='; then
    env_args+=("PROTON_USE_WOW64=1")
  fi
  if [[ $WAYLAND -eq 1 && $GAMESCOPE -eq 0 ]]; then
    # Proton sets WINE_GRAPHICS_DRIVER from PROTON_ENABLE_WAYLAND
    if [[ "$type" == "proton" ]]; then
      env_args+=("PROTON_ENABLE_WAYLAND=1")
    else
      env_args+=("WINE_GRAPHICS_DRIVER=wayland")
    fi
  fi
  env_args+=("${SESSION_ENV[@]}")
  if [[ "$type" == "proton" ]]; then
    prepare_runtime "$runner" "${1:-run}"
    mkdir -p "$PREFIX"
    # Proton looks up a game's fixes by UMU_ID before SteamAppId; a Steam
    # game is left to be found by its app ID, as when Steam runs it
    umu_env=()
    if [[ $STEAM_LAUNCH -eq 0 ]]; then
      umu_env=(UMU_ID="${UMU_ID:-shorin-proton-wrapper}" UMU_USE_STEAM="${UMU_USE_STEAM:-0}")
    fi
    LAUNCH_CMD+=(env "${env_args[@]}"
      STEAM_COMPAT_DATA_PATH="$PREFIX"
      STEAM_COMPAT_CLIENT_INSTALL_PATH="$(steam_root_dir)"
      SteamAppId="${SteamAppId:-0}"
      SteamGameId="${SteamGameId:-0}"
      "${umu_env[@]}"
      "${RUNTIME_PREFIX[@]}" "$runner" "$@")
  else
    mkdir -p "$PREFIX/pfx"
    LAUNCH_CMD+=(env "${env_args[@]}" WINEPREFIX="$PREFIX/pfx" "$runner" "$@")
  fi
}

# Outside any session and without Gamescope, e.g. while creating the prefix.
run_proton_command() {
  local GAMESCOPE=0 WAYLAND=0 JOIN_PREFIX=() SESSION_ENV=()
  build_launch_command proton "$@"
  "${LAUNCH_CMD[@]}"
}

run_wine_command() {
  local GAMESCOPE=0 WAYLAND=0 JOIN_PREFIX=() SESSION_ENV=()
  build_launch_command wine "$@"
  "${LAUNCH_CMD[@]}"
}

# ------------------------------------------------------------------ sessions
# All programs running in a prefix share one wineserver, and with it the
# display driver Wine's desktop picked and the network namespace it lives in.
# The running wineserver is the session: a program started while there is one
# joins it at once (Proton's "run"; "waitforexitandrun" waits for every program
# already running to exit) and keeps its runner and display. With the prefix's
# netns setting on, a session gets its own network namespace from pasta; a
# keeper process inside holds it open until the last program is gone, and
# every program enters it with nsenter. Starting a program takes the session's
# lock until the program is safely part of the session, so two programs
# started at once never set up two sessions.

SESSION_ROOT="${XDG_RUNTIME_DIR:-/tmp/shorin-proton-wrapper-$(id -u)}/shorin-proton-wrapper/sessions"
SESSION_LOCK_FD=""
SESSION_SETTLE=""
SESSION_NETNS=""
SESSION_KEEPER_PID=""
SESSION_ACTIVE=0
# what the program took on from the running session, for its log
SESSION_NOTES=()
# what the user is told
SESSION_NOTICE=()
SESSION_INHERITED=0
LAUNCH_TOKEN=""
PROTON_VERB="waitforexitandrun"
HOST_NETNS="$(readlink /proc/self/ns/net 2>/dev/null || true)"

session_message() {
  local key="$1" arg="${2:-}"
  if [[ "$(ui_lang)" == "zh" ]]; then
    case "$key" in
      netns_busy) printf '这个前置环境里有程序正在普通网络中运行，独立网络要等它们全部关闭后才生效。请先关闭这些程序。\n' ;;
      netns_orphan) printf '这个前置环境的独立网络会话已经没有网络了（会话守护进程不在了）。请在管理器的进程页强制关闭这个前置环境的进程后再试。\n' ;;
      no_pasta) printf '这个前置环境开启了独立网络，但没有安装 passt（pasta）。\n' ;;
      no_nsenter) printf '找不到 nsenter（util-linux）。\n' ;;
      keeper_failed) printf '独立网络会话没能启动，见日志：%s\n' "$arg" ;;
      busy_init) printf '这个前置环境里有程序正在运行，请先关闭它们再初始化。\n' ;;
      inherited) printf '前置环境正在运行，自动继承相关设置。\n' ;;
      runner) printf '这个前置环境正在用 %s 运行，这个程序也改用它。\n' "$arg" ;;
      gamescope_session) printf '这个前置环境的程序正在 Gamescope 里运行，其他程序不能再加入。请先关闭它们。\n' ;;
      no_gamescope) printf '这个前置环境已有程序在运行，这次不使用 Gamescope。\n' ;;
      to_wayland) printf '这个前置环境的程序以 Wayland 运行，这个程序也一样。\n' ;;
      to_x11) printf '这个前置环境的程序以 X11 运行，这次不使用 Wayland。\n' ;;
      no_wayland) printf '当前不是 Wayland 桌面，这次以 X11 运行。\n' ;;
      other_session) printf '这里是另一个前置环境的独立网络，不能从这里启动 %s 的程序。\n' "$arg" ;;
      no_launch) printf '这个独立网络会话是旧版本的 wrapper 启动的，里面的 Linux 程序不能启动 Windows 程序。请关闭这个前置环境的程序后再试。\n' ;;
    esac
  else
    case "$key" in
      netns_busy) printf 'Programs of this prefix are running on the normal network. The separate network takes effect once they are all closed; close them first.\n' ;;
      netns_orphan) printf "This prefix's separate network session has lost its network (its keeper is gone). Force close the prefix's processes on the manager's process page and try again.\n" ;;
      no_pasta) printf 'This prefix uses a separate network, but passt (pasta) is not installed.\n' ;;
      no_nsenter) printf 'nsenter (util-linux) was not found.\n' ;;
      keeper_failed) printf 'The separate network session did not start, see the log: %s\n' "$arg" ;;
      busy_init) printf 'Programs of this prefix are running; close them before initializing it.\n' ;;
      inherited) printf 'The prefix is running; this program takes on its settings.\n' ;;
      runner) printf 'This prefix is running with %s; this program uses it too.\n' "$arg" ;;
      gamescope_session) printf 'Programs of this prefix are running in Gamescope, no other program can join them. Close them first.\n' ;;
      no_gamescope) printf 'Programs of this prefix are already running; this time without Gamescope.\n' ;;
      to_wayland) printf 'Programs of this prefix run on Wayland; so does this one.\n' ;;
      to_x11) printf 'Programs of this prefix run on X11; this time without Wayland.\n' ;;
      no_wayland) printf 'This is not a Wayland desktop; running on X11 this time.\n' ;;
      other_session) printf "This is another prefix's separate network; programs of %s cannot be started from here.\n" "$arg" ;;
      no_launch) printf 'This separate network session was started by an older version of the wrapper; its Linux programs cannot start Windows programs. Close the programs of this prefix and try again.\n' ;;
    esac
  fi
}

notify_info() {
  notify_send normal "$DOWNLOAD_NOTIFY_EXPIRE" "Shorin Proton Wrapper" "$1"
}

# Settings of the prefix itself, next to its pfx.
prefix_conf_file() {
  printf '%s/.shorin-proton-wrapper.conf\n' "$PREFIX"
}

prefix_netns_enabled() {
  local file
  file="$(prefix_conf_file)"
  [[ -r "$file" ]] && grep -qx 'netns=1' "$file"
}

set_prefix_netns() {
  local file tmp
  file="$(prefix_conf_file)"
  tmp="$file.tmp.$$"
  mkdir -p "$PREFIX"
  {
    if [[ -r "$file" ]]; then
      grep -v '^netns=' "$file" || true
    fi
    printf 'netns=%s\n' "$1"
  } > "$tmp"
  mv "$tmp" "$file"
}

pid_netns() {
  readlink "/proc/$1/ns/net" 2>/dev/null || true
}

# The value of one variable in a process's environment.
pid_env() {
  local line
  {
    while IFS= read -r -d '' line; do
      if [[ "$line" == "$2="* ]]; then
        printf '%s\n' "${line#*=}"
        break
      fi
    done < "/proc/$1/environ"
  } 2>/dev/null || true
}

# The prefix's wineserver, in whichever namespace it runs. Wine names the
# server directory after the device and inode of the prefix, and the server
# keeps it as its working directory.
prefix_wineserver_pid() {
  local st suffix pid cwd
  st="$(stat -L -c '%d %i' "$PREFIX/pfx" 2>/dev/null)" || return 1
  printf -v suffix 'server-%x-%x' "${st% *}" "${st#* }"
  for pid in $(pgrep -x wineserver 2>/dev/null || true); do
    cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)" || continue
    if [[ "$cwd" == /tmp/.wine-*/"$suffix" ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 1
}

session_dir() {
  printf '%s/%s\n' "$SESSION_ROOT" "$(printf '%s' "$PREFIX" | sha256sum | cut -c1-16)"
}

# The live keeper of the prefix's network namespace session.
session_keeper_pid() {
  local dir="$1" pid netns
  pid="$(cat "$dir/keeper.pid" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  netns="$(pid_netns "$pid")"
  [[ -n "$netns" && "$(cat "$dir/netns" 2>/dev/null)" == "$netns" ]] || return 1
  printf '%s\n' "$pid"
}

prefix_session_active() {
  prefix_wineserver_pid > /dev/null || session_keeper_pid "$(session_dir)" > /dev/null
}

# The session whose network namespace the wrapper itself runs in, if any: a
# program of the session started it, Steam running there say.
session_here() {
  local file
  [[ -n "$HOST_NETNS" ]] || return 1
  for file in "$SESSION_ROOT"/*/netns; do
    if [[ -r "$file" && "$(cat "$file")" == "$HOST_NETNS" ]]; then
      dirname "$file"
      return 0
    fi
  done
  return 1
}

# Whether the wrapper runs in the session's user namespace, as the session's
# Windows programs do, rather than in the one of a Linux program of the
# session (see run_linux_target), from which it cannot enter the session.
session_userns_here() {
  local dir="$1"
  if [[ -r "$dir/userns" ]]; then
    [[ "$(cat "$dir/userns")" == "$(readlink /proc/self/ns/user 2> /dev/null)" ]]
  else
    # a keeper of an older version: only its user namespace can look at it
    session_keeper_pid "$dir" > /dev/null
  fi
}

session_lock() {
  local dir
  dir="$(session_dir)"
  mkdir -p "$dir"
  exec {SESSION_LOCK_FD}>"$dir/lock"
  flock "$SESSION_LOCK_FD"
}

session_unlock() {
  [[ -n "$SESSION_LOCK_FD" ]] || return 0
  flock -u "$SESSION_LOCK_FD" 2> /dev/null || true
  exec {SESSION_LOCK_FD}>&-
  SESSION_LOCK_FD=""
}

# MAC address for the adapter inside the namespace. pasta makes up a new one on
# every start, which to anti-cheat looks like a machine-ID changer; use the one
# of the host adapter the default route goes through instead, so programs see
# the same adapter with or without the namespace. The fallback is the one
# wegame-launcher uses, so both show the same adapter.
namespace_mac_address() {
  local iface dest flags metric best="" best_metric=0 mac hex first
  {
    read -r _
    while read -r iface dest _ flags _ _ metric _; do
      [[ "$dest" == "00000000" ]] || continue
      (( 16#$flags & 1 )) || continue
      if [[ -z "$best" ]] || (( metric < best_metric )); then
        best="$iface"
        best_metric="$metric"
      fi
    done
  } < /proc/net/route 2> /dev/null || true
  if [[ -n "$best" ]]; then
    mac="$(cat "/sys/class/net/$best/address" 2> /dev/null || true)"
    if [[ "$mac" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ && "$mac" != "00:00:00:00:00:00" ]]; then
      printf '%s\n' "$mac"
      return 0
    fi
  fi
  hex="$({ printf 'wegame-launcher netns '; cat /etc/machine-id 2> /dev/null || printf '%s' "$HOME"; } | sha256sum | cut -c1-12)"
  first=$(( (16#${hex:0:2} & 0xfc) | 0x02 ))
  printf '%02x:%s:%s:%s:%s:%s\n' "$first" "${hex:2:2}" "${hex:4:2}" "${hex:6:2}" "${hex:8:2}" "${hex:10:2}"
}

# Start the prefix's network namespace and its keeper; sets SESSION_KEEPER_PID.
session_start() {
  local dir="$1" log mac i
  command -v pasta > /dev/null 2>&1 || die_visible "$(session_message no_pasta)"
  command -v nsenter > /dev/null 2>&1 || die_visible "$(session_message no_nsenter)"
  rm -f "$dir/keeper.pid" "$dir/netns" "$dir/userns" "$dir/bus" "$dir/launch"
  log="$WRAPPER_CACHE_DIR/logs/session-$(basename "$dir").log"
  mkdir -p "$(dirname "$log")"
  mac="$(namespace_mac_address)"
  printf -- '--- %s %s\n' "$(date '+%F %T')" "$PREFIX" >> "$log"
  # pasta forwards automatically only the host's ports outside the ephemeral
  # range; the Steam client's 57343, in it, the keeper forwards itself while
  # the host's Steam runs. A game Steam starts brings Steam's overlay in
  # LD_PRELOAD, which the namespace's own programs must not get.
  setsid env -u SHORIN_PROTON_WRAPPER_APP_ID -u SHORIN_PROTON_WRAPPER_APP_PATH -u SHORIN_PROTON_WRAPPER_LOG -u LD_PRELOAD \
    SHORIN_PROTON_WRAPPER_PREFIX="$PREFIX" \
    pasta --config-net --ns-mac-addr "$mac" -T auto -f --no-pidns -- "$SELF_PATH" --session-keeper "$dir" \
    >> "$log" 2>&1 < /dev/null {SESSION_LOCK_FD}>&- &
  for ((i = 0; i < 75; i++)); do
    if SESSION_KEEPER_PID="$(session_keeper_pid "$dir")"; then
      printf 'Session: separate network namespace started, log %s\n' "$log"
      return 0
    fi
    sleep 0.2
  done
  die_visible "$(session_message keeper_failed "$log")"
}

# Run with the session's runner: a wineserver only talks to its own version.
session_adopt_runner() {
  local exe bin root type path
  exe="$(readlink "/proc/$1/exe" 2> /dev/null || true)"
  exe="${exe% (deleted)}"
  exe="${exe#/run/host}"
  [[ -n "$exe" ]] || return 0
  bin="$(dirname "$exe")"
  root="$(dirname "$bin")"
  if [[ "$(basename "$root")" == "files" ]]; then
    root="$(dirname "$root")"
  fi
  if [[ -x "$root/proton" ]]; then
    type="proton"
    path="$(realpath -m "$root/proton")"
  elif [[ -x "$bin/wine" ]]; then
    type="wine"
    path="$(realpath -m "$bin/wine")"
  else
    return 0
  fi
  if [[ "$path" != "$(realpath -m "$RESOLVED_RUNNER_PATH")" ]]; then
    SESSION_NOTES+=("$(session_message runner "$(runner_name_from_path "$type" "$path")")")
    SESSION_INHERITED=1
    RESOLVED_RUNNER_TYPE="$type"
    RESOLVED_RUNNER_PATH="$path"
  fi
  return 0
}

# How the session shows its windows. The wineserver keeps the environment of
# the program that started it: a nested Gamescope leaves its own display there
# (one the desktop itself runs in, e.g. Steam's game mode, is everyone's).
session_display_kind() {
  local gamescope
  gamescope="$(pid_env "$1" GAMESCOPE_WAYLAND_DISPLAY)"
  if [[ -n "$gamescope" && "$gamescope" != "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]]; then
    printf 'gamescope\n'
  elif [[ "$(pid_env "$1" WINE_GRAPHICS_DRIVER)" == "wayland" ]]; then
    printf 'wayland\n'
  else
    printf 'x11\n'
  fi
}

# Wine's desktop picks the display driver and screen for every program of the
# session, so a program joining it shows its windows the way the session does.
# A program in another Gamescope would draw there while thinking the screen is
# the desktop's; one joining a Gamescope session would lose its windows when
# the program that runs Gamescope exits.
session_adopt_display() {
  local kind
  kind="$(session_display_kind "$1")"
  if [[ "$kind" == "gamescope" ]]; then
    die_visible "$(session_message gamescope_session)"
  fi
  if [[ $GAMESCOPE -eq 1 ]]; then
    GAMESCOPE=0
    SESSION_NOTES+=("$(session_message no_gamescope)")
    SESSION_INHERITED=1
  fi
  if [[ "$kind" == "wayland" && $WAYLAND -eq 0 ]]; then
    WAYLAND=1
    SESSION_NOTES+=("$(session_message to_wayland)")
    SESSION_INHERITED=1
  elif [[ "$kind" == "x11" && $WAYLAND -eq 1 ]]; then
    WAYLAND=0
    SESSION_NOTES+=("$(session_message to_x11)")
    SESSION_INHERITED=1
  fi
  return 0
}

# Decide how this launch enters the prefix's session, setting one up when there
# is none: PROTON_VERB, JOIN_PREFIX and SESSION_ENV for build_launch_command.
# It may switch the runner, Gamescope and Wayland to match the running session.
session_prepare() {
  local dir ws ws_netns keeper overrides item want_netns=0 inside=0
  dir="$(session_dir)"
  [[ -n "$SESSION_LOCK_FD" ]] || session_lock
  if prefix_netns_enabled; then
    want_netns=1
  fi
  # started from inside the session's namespace, by its keeper for a Linux
  # program of the session (delegate_to_keeper)
  if [[ "$(session_here || true)" == "$dir" ]]; then
    inside=1
  fi
  JOIN_PREFIX=()
  SESSION_ENV=()
  SESSION_NOTES=()
  SESSION_NOTICE=()
  SESSION_INHERITED=0
  SESSION_NETNS=""
  SESSION_SETTLE="wineserver"
  PROTON_VERB="waitforexitandrun"
  LAUNCH_TOKEN="$$-$RANDOM$RANDOM"
  keeper="$(session_keeper_pid "$dir" || true)"
  ws="$(prefix_wineserver_pid || true)"

  SESSION_ACTIVE=0
  if [[ -n "$ws" ]]; then
    SESSION_ACTIVE=1
    ws_netns="$(pid_netns "$ws")"
    if [[ $inside -eq 0 && "$ws_netns" == "$HOST_NETNS" ]]; then
      if [[ $want_netns -eq 1 ]]; then
        die_visible "$(session_message netns_busy)"
      fi
      keeper=""
    elif [[ -z "$keeper" || "$(pid_netns "$keeper")" != "$ws_netns" ]]; then
      die_visible "$(session_message netns_orphan)"
    fi
    session_adopt_runner "$ws"
    session_adopt_display "$ws"
    PROTON_VERB="run"
    # Proton runs a program's fixes (protonfixes) only for waitforexitandrun,
    # which would first wait for the session to end; WE-Proton also runs them
    # for this run when asked to
    SESSION_ENV+=("PROTONFIXES_RUN_VERB=1")
    SESSION_SETTLE=""
  elif [[ -z "$keeper" && $want_netns -eq 1 ]]; then
    [[ $inside -eq 0 ]] || die_visible "$(session_message netns_orphan)"
    session_start "$dir"
    keeper="$SESSION_KEEPER_PID"
  fi

  if [[ -n "$keeper" ]]; then
    SESSION_NETNS="$(pid_netns "$keeper")"
    if [[ $inside -eq 0 ]]; then
      JOIN_PREFIX=(nsenter -t "$keeper" -U -n --preserve-credentials --)
    fi
    # pasta maps the user to root in the session; map Steam games back so the
    # overlay's uid-named shared memory matches the Steam client's. Other
    # Windows programs (accelerator clients) keep uid 0, which keeps
    # CAP_NET_ADMIN for the TUN device they create in the namespace.
    if [[ "$HOST_UID" -ne 0 && $STEAM_LAUNCH -eq 1 ]] && { [[ $inside -eq 0 ]] || [[ "$(id -u)" -eq 0 ]]; }; then
      JOIN_PREFIX+=(unshare -U --map-user="$HOST_UID" --map-group="$HOST_GID" --)
    fi
    if [[ -n "$ws" ]]; then
      SESSION_SETTLE="joined"
    fi
    # an accelerator's wintun.dll would install a Windows driver; WE-Proton's
    # builtin one creates a TUN adapter in the namespace instead
    overrides="${WINEDLLOVERRIDES:-}"
    for item in "${CACHED_ENV[@]}"; do
      if [[ "$item" == WINEDLLOVERRIDES=* ]]; then
        overrides="${item#*=}"
      fi
    done
    SESSION_ENV+=("WINEDLLOVERRIDES=${overrides:+$overrides;}wintun=b")
    # pasta maps the user to root in the namespace, which the session bus
    # refuses; the keeper bridges it
    if [[ -S "$dir/bus" ]]; then
      SESSION_ENV+=("DBUS_SESSION_BUS_ADDRESS=unix:path=$dir/bus")
    fi
  fi
  SESSION_ENV+=("SHORIN_PROTON_WRAPPER_LAUNCH=$LAUNCH_TOKEN")

  if [[ $WAYLAND -eq 1 && $GAMESCOPE -eq 0 && -z "${WAYLAND_DISPLAY:-}" ]]; then
    WAYLAND=0
    SESSION_NOTES+=("$(session_message no_wayland)")
    SESSION_NOTICE+=("$(session_message no_wayland)")
  fi
  if [[ $SESSION_INHERITED -eq 1 ]]; then
    SESSION_NOTICE=("$(session_message inherited)" "${SESSION_NOTICE[@]}")
  fi
  if (( ${#SESSION_NOTES[@]} )); then
    printf 'Session: %s\n' "${SESSION_NOTES[@]}"
  fi
  if (( ${#SESSION_NOTICE[@]} )); then
    notify_info "$(printf '%s\n' "${SESSION_NOTICE[@]}")"
  fi
  printf 'Session: verb %s%s\n' "$PROTON_VERB" "${keeper:+, network namespace of keeper $keeper}"
}

# Whether a process of this launch has entered the session's namespace.
session_token_in_netns() {
  python3 - "$SESSION_NETNS" "SHORIN_PROTON_WRAPPER_LAUNCH=$LAUNCH_TOKEN" <<'PY'
import os
import sys

netns, token = sys.argv[1], sys.argv[2].encode()
for name in os.listdir("/proc"):
    if not name.isdigit():
        continue
    try:
        if os.readlink(f"/proc/{name}/ns/net") != netns:
            continue
        with open(f"/proc/{name}/environ", "rb") as file:
            if token in file.read().split(b"\0"):
                sys.exit(0)
    except OSError:
        pass
sys.exit(1)
PY
}

# Hold the session lock until the program is part of the session: a new
# session's wineserver is up (so the next program sees its runner and display),
# or a joining program is inside the namespace (so the keeper cannot find it
# empty in between and close it).
session_wait_settled() {
  local child="$1" i
  case "$SESSION_SETTLE" in
    wineserver)
      for ((i = 0; i < 600; i++)); do
        prefix_wineserver_pid > /dev/null && return 0
        kill -0 "$child" 2> /dev/null || return 0
        sleep 0.2
      done
      ;;
    joined)
      for ((i = 0; i < 75; i++)); do
        session_token_in_netns && return 0
        kill -0 "$child" 2> /dev/null || return 0
        sleep 0.2
      done
      ;;
  esac
  return 0
}

# Run LAUNCH_CMD in the session and return its exit status.
launch_in_session() {
  local child status=0
  if [[ -n "$SESSION_LOCK_FD" ]]; then
    "${LAUNCH_CMD[@]}" {SESSION_LOCK_FD}>&- &
  else
    "${LAUNCH_CMD[@]}" &
  fi
  child=$!
  # a background job ignores SIGINT; pass on what would end the program
  trap 'kill -TERM "$child" 2> /dev/null || true' INT TERM HUP
  session_wait_settled "$child"
  session_unlock
  while true; do
    status=0
    wait "$child" || status=$?
    kill -0 "$child" 2> /dev/null || break
  done
  trap - INT TERM HUP
  return "$status"
}

# wineboot leaves its wineserver up for a few seconds; let it go, so the
# program started next sets the session up the way it is configured.
wait_wineserver_exit() {
  local i
  for ((i = 0; i < 100; i++)); do
    prefix_wineserver_pid > /dev/null || return 0
    sleep 0.2
  done
  return 0
}

init_prefix() {
  local status log
  select_init_runner
  if prefix_session_active; then
    die_visible "$(session_message busy_init)"
  fi

  # Creating a prefix takes minutes on first run. Without this the desktop
  # launch looks dead between the runner install and the program window.
  log="$WRAPPER_CACHE_DIR/logs/init.log"
  mkdir -p "$(dirname "$log")"
  notify_progress "Shorin Proton Wrapper" "$(download_message init "")"

  status=0
  if [[ "$RESOLVED_RUNNER_TYPE" == "proton" ]]; then
    run_proton_command "$RESOLVED_RUNNER_PATH" run wineboot -u > >(tee -a "$log") 2>&1 || status=$?
  else
    run_wine_command "$RESOLVED_RUNNER_PATH" wineboot -u > >(tee -a "$log") 2>&1 || status=$?
  fi

  if [[ $status -ne 0 ]]; then
    notify_error "$(download_message init_failed "")"$'\n'"$log"
    die "failed to initialize prefix: $PREFIX (exit $status)
See $log"
  fi
  wait_wineserver_exit
}

ensure_initialized() {
  if [[ ! -d "$PREFIX/pfx" ]]; then
    init_prefix
  fi
}

apply_cached_env_vars() {
  local encoded="$1" tmp status
  CACHED_ENV=()
  [[ -n "$encoded" ]] || return 0
  tmp="$(mktemp)"
  python3 - "$encoded" > "$tmp" <<'PY'
import shlex
import sys
from urllib.parse import unquote

text = unquote(sys.argv[1])
try:
    parts = shlex.split(text)
except ValueError:
    parts = [line.strip() for line in text.splitlines()]
for part in parts:
    if "=" not in part or part.startswith("="):
        continue
    sys.stdout.write(part)
    sys.stdout.write("\0")
PY
  status=$?
  if [[ $status -eq 0 ]]; then
    mapfile -d '' -t CACHED_ENV < "$tmp"
  fi
  rm -f "$tmp"
}

association_cache_file_for() {
  local target_path="$1" cache_dir key
  cache_dir="$XDG_CACHE_HOME_VALUE/shorin-proton-wrapper/associations"
  key="$(printf '%s' "$target_path" | sha256sum | cut -d ' ' -f 1)"
  printf '%s/%s.conf\n' "$cache_dir" "$key"
}

should_record_association() {
  local target_path="$1" name
  name="$(basename "$target_path")"
  name="${name%.*}"
  name="${name,,}"
  case "$name" in
    *setup*|*install*|*installer*|*uninstall*|unins*|*update*|*updater*|*patch*|*crash*|*helper*|*redist*|*vcredist*|*vc_redist*|dxsetup)
      return 1
      ;;
  esac
  return 0
}

record_default_association() {
  local target_path="$1" cache_file
  case "${target_path,,}" in
    *.exe|*.lnk) ;;
    *) return 0 ;;
  esac
  should_record_association "$target_path" || return 0
  cache_file="$(association_cache_file_for "$target_path")"
  if [[ ! -e "$cache_file" ]]; then
    record_new_association "$target_path" "$cache_file"
