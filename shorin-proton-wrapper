#!/usr/bin/env bash
set -euo pipefail

ORIGINAL_ARGS=("$@")
DEFAULT_PREFIX="${PROTON_PREFIX:-$HOME/.proton}"
XDG_DATA_HOME_VALUE="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CACHE_HOME_VALUE="${XDG_CACHE_HOME:-$HOME/.cache}"
# Runners go where Steam keeps compatibility tools, which other launchers read
# too; earlier versions installed them in LOCAL_RUNNER_DIR, still used.
STEAM_RUNNER_DIR="$HOME/.local/share/Steam/compatibilitytools.d"
LOCAL_RUNNER_DIR="$XDG_DATA_HOME_VALUE/proton/runners"
WRAPPER_CACHE_DIR="$XDG_CACHE_HOME_VALUE/shorin-proton-wrapper"
INSTALL_DOWNLOAD_DIR="$WRAPPER_CACHE_DIR/downloads"
DOWNLOAD_TIMEOUT_SECONDS="${SHORIN_PROTON_WRAPPER_DOWNLOAD_TIMEOUT:-0}"
DOWNLOAD_STALL_SECONDS="${SHORIN_PROTON_WRAPPER_DOWNLOAD_STALL:-120}"
DOWNLOAD_NOTIFY_INTERVAL="${SHORIN_PROTON_WRAPPER_NOTIFY_INTERVAL:-8}"
DOWNLOAD_NOTIFY_EXPIRE="${SHORIN_PROTON_WRAPPER_NOTIFY_EXPIRE:-8000}"
STEAM_ROOT="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.steam/root}"
# Proton runs inside the Steam Linux Runtime its toolmanifest.vdf asks for;
# set SHORIN_PROTON_WRAPPER_RUNTIME=0 to run it directly on the host.
RUNTIME_ENABLED="${SHORIN_PROTON_WRAPPER_RUNTIME:-1}"
RUNTIME_DIR="$XDG_DATA_HOME_VALUE/shorin-proton-wrapper/runtime"
RUNTIME_PREFIX=()

# 0 means no total cap: a slow but healthy download must not be killed.
# Stalled transfers are caught by DOWNLOAD_STALL_SECONDS instead.
[[ "$DOWNLOAD_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || DOWNLOAD_TIMEOUT_SECONDS=0
[[ "$DOWNLOAD_STALL_SECONDS" =~ ^[0-9]+$ && "$DOWNLOAD_STALL_SECONDS" -gt 0 ]] || DOWNLOAD_STALL_SECONDS=120
[[ "$DOWNLOAD_NOTIFY_INTERVAL" =~ ^[0-9]+$ && "$DOWNLOAD_NOTIFY_INTERVAL" -gt 0 ]] || DOWNLOAD_NOTIFY_INTERVAL=8
[[ "$DOWNLOAD_NOTIFY_EXPIRE" =~ ^[0-9]+$ && "$DOWNLOAD_NOTIFY_EXPIRE" -gt 0 ]] || DOWNLOAD_NOTIFY_EXPIRE=8000

INSTALL_ERROR=""
INSTALL_LOG=""

ACTION=""
PRODUCT=""
VERSION="latest"
PREFIX="$DEFAULT_PREFIX"
RUNNER_ARG="${PROTON_RUNNER:-}"
DOWNLOAD_DIR=""
INSTALL_DIR=""
INSTALL_TO="default"
CLEAN=0
TARGET=""
TARGET_ARGS=()
# 1 when the target came from a Steam launch option, see take_steam_command
STEAM_LAUNCH=0
LANG_OVERRIDE="${PROTON_LANG:-}"
GAMESCOPE=0
GAMESCOPE_FULLSCREEN=1
GAMESCOPE_RES=""
GAMESCOPE_FPS=""
GAMESCOPE_FSR=0
GAMESCOPE_EXTRA=""
MANGOHUD=0
WAYLAND=0
DEBUG=0
DEBUG_LOG=""
RUN_APP_ID=""
RUN_LOG=""
PREFIX_EXPLICIT=0
RUNNER_EXPLICIT=0
GAMESCOPE_EXPLICIT=0
MANGOHUD_EXPLICIT=0
WAYLAND_EXPLICIT=0
NETNS_ARG=""
# Runner installed and used when nothing else is chosen.
DEFAULT_PRODUCT="we"

if [[ "$0" == */* ]]; then
  SELF_PATH="$(realpath -m "$0")"
else
  SELF_PATH="$(command -v shorin-proton-wrapper || printf 'shorin-proton-wrapper')"
fi

# The host uid/gid, so a wrapper started inside the session can map the user
# back to them: pasta shows the user as root in the session's user namespace.
HOST_UID="${SHORIN_PROTON_WRAPPER_HOST_UID:-$(id -u)}"
HOST_GID="${SHORIN_PROTON_WRAPPER_HOST_GID:-$(id -g)}"
export SHORIN_PROTON_WRAPPER_HOST_UID="$HOST_UID" SHORIN_PROTON_WRAPPER_HOST_GID="$HOST_GID"

RUNNER_TYPES=()
RUNNER_SOURCES=()
RUNNER_NAMES=()
RUNNER_PATHS=()
DEBUG_ENV=()
CACHED_ENV=()
RUN_ENV=()
declare -A RUNNER_SEEN=()

[[ -n "${PROTON_PREFIX:-}" ]] && PREFIX_EXPLICIT=1
[[ -n "${PROTON_RUNNER:-}" ]] && RUNNER_EXPLICIT=1

ui_lang() {
  local locale="${LANG_OVERRIDE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
  case "${locale,,}" in
    zh|zh_*|zh.*|zh-*) printf 'zh\n' ;;
    *) printf 'en\n' ;;
  esac
}

setup_debug_logging() {
  local log_dir name timestamp
  [[ $DEBUG -eq 1 ]] || return 0

  log_dir="$XDG_CACHE_HOME_VALUE/shorin-proton-wrapper/logs"
  mkdir -p "$log_dir"
  DEBUG_ENV=("PROTON_LOG=1" "PROTON_LOG_DIR=$log_dir")
  [[ -n "$TARGET" ]] && return 0

  name="${ACTION:-command}"
  name="$(safe_log_name "$name")"
  timestamp="$(date +%Y%m%d-%H%M%S)"
  DEBUG_LOG="$log_dir/$timestamp-$name.log"
  exec > >(tee -a "$DEBUG_LOG") 2>&1
  printf 'Debug log: %s\n' "$DEBUG_LOG"
  printf 'Command: shorin-proton-wrapper'
  printf ' %q' "${ORIGINAL_ARGS[@]}"
  printf '\n'
}

safe_log_name() {
  local name="$1"
  name="$(basename "${name:-command}")"
  printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_'
}

wrapper_app_id() {
  local prefix="$1" target="$2"
  python3 - "$prefix" "$target" <<'PY'
import hashlib
import sys

print(hashlib.sha256((sys.argv[1] + "\0" + sys.argv[2]).encode()).hexdigest()[:10])
PY
}

setup_run_logging() {
  local log_dir
  RUN_APP_ID="$(wrapper_app_id "$PREFIX" "$TARGET")"
  log_dir="$XDG_CACHE_HOME_VALUE/shorin-proton-wrapper/logs/$RUN_APP_ID"
  mkdir -p "$log_dir"
  rm -f "$log_dir"/*.log
  RUN_LOG="$log_dir/latest.log"
  RUN_ENV=(
    "SHORIN_PROTON_WRAPPER_APP_ID=$RUN_APP_ID"
    "SHORIN_PROTON_WRAPPER_APP_PATH=$TARGET"
    "SHORIN_PROTON_WRAPPER_PREFIX=$PREFIX"
    "SHORIN_PROTON_WRAPPER_LOG=$RUN_LOG"
  )
  if [[ $DEBUG -eq 1 ]]; then
    DEBUG_ENV=("PROTON_LOG=1" "PROTON_LOG_DIR=$log_dir")
  fi

  exec > >(tee -a "$RUN_LOG") 2>&1
  printf 'Log: %s\n' "$RUN_LOG"
  printf 'Command: shorin-proton-wrapper'
  printf ' %q' "${ORIGINAL_ARGS[@]}"
  printf '\n'
  printf 'App ID: %s\n' "$RUN_APP_ID"
  printf 'Target: %s\n' "$TARGET"
  printf 'Prefix: %s\n' "$PREFIX"
  printf 'Runner: %s\n' "$RESOLVED_RUNNER_PATH"
  printf 'Runner type: %s\n' "$RESOLVED_RUNNER_TYPE"
  if [[ $DEBUG -eq 1 ]]; then
    printf 'Proton debug log dir: %s\n' "$log_dir"
  fi
  printf -- '--- output ---\n'
}

usage_en() {
  cat <<'EOF'
Usage:
  shorin-proton-wrapper [options] app.exe [args...]
  shorin-proton-wrapper [-p DIR] command [args...]   run a Linux program in the prefix's separate network

Options:
  --init                     initialize prefix, default ~/.proton
  -p, --prefix DIR           prefix directory, initialize if needed
  --status                   show prefix information
  --list-runner              list installed runners
  --runner PATH|ge|dw|we     use specified runner
  --install ge|dw|we         install runner to ~/.local/share/Steam/compatibilitytools.d
  --install-steam ge|dw|we   same as --install
  --install-lutris ge|dw|we  install runner for Lutris
  --download ge|dw|we        download runner only, default XDG download directory
  --list-version ge|dw|we    list available runner versions
  --version VERSION          use specific release tag, default latest
  --update                   update all installed Latest runners
  --check-update             check for available runner updates (no install)
  --doctor                   check wrapper environment and print diagnostics
  --remove ge|dw|we          remove runner from the default location
  --remove-steam ge|dw|we    remove runner from Steam, omit ge|dw|we to remove all wrapper-installed runners
  --remove-lutris ge|dw|we   remove runner from Lutris, omit ge|dw|we to remove all wrapper-installed runners
  --gs, --gamescope          run with Gamescope; use for compatibility, custom resolution/FPS, or FSR
  --mangohud                 enable MangoHud performance overlay
  --wayland                  run with Wine's Wayland driver (Proton runners, not with Gamescope)
  --netns on|off             give the prefix its own network namespace (for game accelerators), needs passt
  --debug                    write full debug log to ~/.cache/shorin-proton-wrapper/logs
  --help-full                show detailed help

Examples:
  shorin-proton-wrapper --init
  shorin-proton-wrapper /path/to/app.exe
  shorin-proton-wrapper --runner /path/to/proton /path/to/app.exe
  shorin-proton-wrapper -p /path/to/prefix /path/to/app.exe
  shorin-proton-wrapper --install we
  shorin-proton-wrapper --install-steam we
  shorin-proton-wrapper --download ge --version GE-Proton10-34
